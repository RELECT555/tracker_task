# Docker Compose — локальные переопределения (опционально)
# Скопируйте: cp .env.docker.example .env
# docker compose автоматически подхватит .env в корне репозитория

POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker
POSTGRES_DB=tracker
POSTGRES_PORT=5432

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
