{
  "name": "tracker-task",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:clean": "npm run clean -w @tracker/web && turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:generate": "npm run db:generate -w @tracker/api",
    "db:migrate": "npm run db:migrate -w @tracker/api",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @tracker/api",
    "db:migrate:reset": "npm run db:migrate:reset -w @tracker/api",
    "db:seed": "npm run db:seed -w @tracker/api",
    "db:status": "npm run db:status -w @tracker/api",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:setup": "node scripts/db-setup.js"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.2"
}
