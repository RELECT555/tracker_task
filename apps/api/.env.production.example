# Production — пример переменных для apps/api
# Храните реальные значения в секрет-хранилище (GitHub Secrets, Vault, K8s Secret).

NODE_ENV=production
PORT=3001

# Managed PostgreSQL (SSL обязателен)
# DATABASE_URL="postgresql://USER:PASSWORD@db.example.com:5432/tracker?schema=public&sslmode=require"

# Для PgBouncer / connection pooler (transaction mode):
# DATABASE_URL="postgresql://USER:PASSWORD@pooler.example.com:6432/tracker?schema=public&sslmode=require&pgbouncer=true"

JWT_SECRET="generate-strong-random-secret-min-32-chars"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# Только JWT, без dev fallback
AUTH_MODE=strict

# В production DEV_USER_ID не используется

REDIS_URL="redis://redis.example.com:6379"
S3_ENDPOINT="https://s3.example.com"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="tracker-attachments-prod"
