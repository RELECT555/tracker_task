generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  url = env("DATABASE_URL")
}

model Role {
  id String @id @default(uuid()) @db.Uuid

  code String @unique @db.VarChar(50)

  name String @db.VarChar(100)

  description String?

  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid

  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model OrgUnit {
  id String @id @default(uuid()) @db.Uuid

  name String @db.VarChar(255)

  parentId String? @map("parent_id") @db.Uuid

  headId String? @map("head_id") @db.Uuid

  path String @db.VarChar(1000)

  parent OrgUnit? @relation("OrgHierarchy", fields: [parentId], references: [id])

  children OrgUnit[] @relation("OrgHierarchy")

  head User? @relation("OrgUnitHead", fields: [headId], references: [id])

  users User[] @relation("UserOrgUnit")

  @@index([parentId])
  @@index([path])
  @@map("org_units")
}

model User {
  id String @id @default(uuid()) @db.Uuid

  email String @unique @db.VarChar(255)

  externalId String? @unique @map("external_id") @db.VarChar(64)

  passwordHash String? @map("password_hash") @db.VarChar(255)

  fullName String @map("full_name") @db.VarChar(255)

  orgUnitId String @map("org_unit_id") @db.Uuid

  managerId String? @map("manager_id") @db.Uuid

  isActive Boolean @default(true) @map("is_active")

  roadmapTablePreferences Json? @map("roadmap_table_preferences")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  orgUnit OrgUnit @relation("UserOrgUnit", fields: [orgUnitId], references: [id])

  manager User? @relation("UserManager", fields: [managerId], references: [id])

  subordinates User[] @relation("UserManager")

  roles UserRole[]

  headedUnits OrgUnit[] @relation("OrgUnitHead")

  requests Request[] @ignore

  assignments Assignment[] @ignore

  transitions Transition[] @ignore

  comments Comment[] @ignore

  auditLogs AuditLog[] @ignore

  notifications Notification[] @ignore

  roadmapNotifications RoadmapNotification[]

  @@index([orgUnitId])
  @@index([managerId])
  @@index([email])
  @@map("users")
}

// Historical approval workflow tables are kept for existing databases.
// Ignored models and relations are excluded from the generated Prisma Client.
model RouteTemplate {
  id String @default(uuid()) @db.Uuid

  name String @db.VarChar(255)

  version Int @default(1)

  isPublished Boolean @default(false) @map("is_published")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  steps RouteStepTemplate[]

  @@id([id, version])
  @@ignore
  @@map("route_templates")
}

model RouteStepTemplate {
  id String @id @default(uuid()) @db.Uuid

  routeTemplateId String @map("route_template_id") @db.Uuid

  routeTemplateVersion Int @map("route_template_version")

  stepOrder Int @map("step_order")

  name String @db.VarChar(255)

  assigneeType String @map("assignee_type") @db.VarChar(50)

  assigneeRef String @map("assignee_ref") @db.VarChar(255)

  actions String[] @default(["approve", "reject"])

  slaHours Int? @map("sla_hours")

  routeTemplate RouteTemplate @relation(fields: [routeTemplateId, routeTemplateVersion], references: [id, version], onDelete: Cascade)

  @@index([routeTemplateId, routeTemplateVersion])
  @@ignore
  @@map("route_step_templates")
}

model RequestType {
  id String @id @default(uuid()) @db.Uuid

  code String @unique @db.VarChar(50)

  name String @db.VarChar(255)

  description String?

  fieldSchema Json @default("[]") @map("field_schema")

  defaultRouteTemplateId String? @map("default_route_template_id") @db.Uuid

  allowedManualRoutes String[] @default([]) @map("allowed_manual_routes") @db.Uuid

  allowsPersonalRoute Boolean @default(false) @map("allows_personal_route")

  maxPersonalRouteSteps Int @default(5) @map("max_personal_route_steps")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  requests Request[]

  @@ignore
  @@map("request_types")
}

model Request {
  id String @id @default(uuid()) @db.Uuid

  typeId String @map("type_id") @db.Uuid

  authorId String @map("author_id") @db.Uuid

  title String @db.VarChar(500)

  fields Json @default("{}")

  status String @default("draft") @db.VarChar(30)

  priority String @default("normal") @db.VarChar(20)

  routeSnapshot Json? @map("route_snapshot")

  currentStepIndex Int? @map("current_step_index")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  submittedAt DateTime? @map("submitted_at") @db.Timestamptz()

  completedAt DateTime? @map("completed_at") @db.Timestamptz()

  type RequestType @relation(fields: [typeId], references: [id])

  author User @relation(fields: [authorId], references: [id])

  assignments Assignment[]

  transitions Transition[]

  comments Comment[]

  notifications Notification[]

  @@index([authorId])
  @@index([status])
  @@index([typeId])
  @@index([createdAt(sort: Desc)])
  @@ignore
  @@map("requests")
}

model Assignment {
  id String @id @default(uuid()) @db.Uuid

  requestId String @map("request_id") @db.Uuid

  stepIndex Int @map("step_index")

  assigneeId String @map("assignee_id") @db.Uuid

  status String @default("pending") @db.VarChar(20)

  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz()

  dueAt DateTime? @map("due_at") @db.Timestamptz()

  completedAt DateTime? @map("completed_at") @db.Timestamptz()

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  assignee User @relation(fields: [assigneeId], references: [id])

  @@index([assigneeId, status])
  @@index([requestId])
  @@ignore
  @@map("assignments")
}

model Transition {
  id String @id @default(uuid()) @db.Uuid

  requestId String @map("request_id") @db.Uuid

  fromStatus String? @map("from_status") @db.VarChar(30)

  toStatus String @map("to_status") @db.VarChar(30)

  fromStep Int? @map("from_step")

  toStep Int? @map("to_step")

  actorId String? @map("actor_id") @db.Uuid

  action String @db.VarChar(50)

  comment String?

  metadata Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  actor User? @relation(fields: [actorId], references: [id])

  @@index([requestId, createdAt])
  @@ignore
  @@map("transitions")
}

model Comment {
  id String @id @default(uuid()) @db.Uuid

  requestId String @map("request_id") @db.Uuid

  authorId String @map("author_id") @db.Uuid

  body String

  isInternal Boolean @default(false) @map("is_internal")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  author User @relation(fields: [authorId], references: [id])

  @@index([requestId, createdAt])
  @@ignore
  @@map("comments")
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  actorId String? @map("actor_id") @db.Uuid

  action String @db.VarChar(100)

  entityType String @map("entity_type") @db.VarChar(50)

  entityId String @map("entity_id") @db.Uuid

  payload Json @default("{}")

  ipAddress String? @map("ip_address") @db.VarChar(45)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@ignore
  @@map("audit_logs")
}

// Earlier local databases may contain this table from a schema push.
model Notification {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  type String @db.VarChar(50)

  title String @db.VarChar(500)

  body String?

  requestId String? @map("request_id") @db.Uuid

  isRead Boolean @default(false) @map("is_read")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  request Request? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@ignore
  @@map("notifications")
}

model SystemSetting {
  key String @id @db.VarChar(100)

  value Json

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("system_settings")
}

model RoadmapProject {
  id         String            @id @default(uuid()) @db.Uuid
  externalId String            @unique @map("external_id") @db.VarChar(100)
  name       String            @db.VarChar(255)
  url        String?           @db.VarChar(1000)
  syncedAt   DateTime?         @map("synced_at") @db.Timestamptz()
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz()
  workItems  RoadmapWorkItem[]
  createRequests RoadmapWorkItemCreateRequest[]
  roles      RoadmapRole[]
  azureState RoadmapAzureProjectState?
  access     RoadmapProjectAccess[]
  alerts     RoadmapAlert[]

  @@map("roadmap_projects")
}

enum RoadmapProjectRole {
  viewer
  planner
}

model RoadmapProjectAccess {
  projectId String             @map("project_id") @db.Uuid
  email     String             @db.VarChar(255)
  role      RoadmapProjectRole
  project   RoadmapProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, email])
  @@index([email])
  @@map("roadmap_project_access")
}

model RoadmapAzureProjectState {
  projectId        String         @id @map("project_id") @db.Uuid
  lastCheckAt      DateTime?      @map("last_check_at") @db.Timestamptz()
  lastCheckResult  Json?          @map("last_check_result")
  lastWebhookAt    DateTime?      @map("last_webhook_at") @db.Timestamptz()
  settingsOverride Json?          @map("settings_override")
  importFailingSince  DateTime?   @map("import_failing_since") @db.Timestamptz()
  lastImportError     String?     @map("last_import_error") @db.VarChar(500)
  lastImportFailedAt  DateTime?   @map("last_import_failed_at") @db.Timestamptz()
  lastImportOkAt      DateTime?   @map("last_import_ok_at") @db.Timestamptz()
  lastImportChangedAt DateTime?   @map("last_import_changed_at") @db.Timestamptz()
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz()
  project          RoadmapProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("roadmap_azure_project_state")
}

model RoadmapAlert {
  id            String                @id @default(uuid()) @db.Uuid
  key           String                @unique @db.VarChar(150)
  kind          String                @db.VarChar(50)
  projectId     String?               @map("project_id") @db.Uuid
  state         String                @db.VarChar(20)
  generation    Int                   @default(0)
  openedAt      DateTime?             @map("opened_at") @db.Timestamptz()
  resolvedAt    DateTime?             @map("resolved_at") @db.Timestamptz()
  resolution    String?               @db.VarChar(20)
  clearSince    DateTime?             @map("clear_since") @db.Timestamptz()
  details       Json
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz()
  project       RoadmapProject?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  notifications RoadmapNotification[]

  @@map("roadmap_alerts")
}

model RoadmapNotification {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  alertId    String       @map("alert_id") @db.Uuid
  generation Int
  kind       String       @db.VarChar(50)
  projectId  String?      @map("project_id") @db.Uuid
  title      String       @db.VarChar(200)
  body       String?      @db.VarChar(1000)
  readAt     DateTime?    @map("read_at") @db.Timestamptz()
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  alert      RoadmapAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@unique([alertId, generation, userId])
  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("roadmap_notifications")
}

model RoadmapWorkItem {
  id               String              @id @default(uuid()) @db.Uuid
  projectId        String              @map("project_id") @db.Uuid
  externalId       String              @map("external_id") @db.VarChar(100)
  parentExternalId String?             @map("parent_external_id") @db.VarChar(100)
  type             String              @db.VarChar(50)
  title            String              @db.VarChar(1000)
  state            String?             @db.VarChar(100)
  url              String?             @db.VarChar(1000)
  actualHours      Decimal?            @map("actual_hours") @db.Decimal(10, 2)
  azureCustomFields Json?               @map("azure_custom_fields")
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz()
  project          RoadmapProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  allocations      RoadmapAllocation[]

  @@unique([projectId, externalId])
  @@index([projectId, type])
  @@index([projectId, parentExternalId])
  @@map("roadmap_work_items")
}

model RoadmapWorkItemCreateRequest {
  requestId   String         @id @map("request_id") @db.Uuid
  projectId   String         @map("project_id") @db.Uuid
  payloadHash String         @map("payload_hash") @db.VarChar(64)
  type        String         @db.VarChar(10)
  status      String         @db.VarChar(20)
  azureOrganization String?  @map("azure_organization") @db.VarChar(255)
  azureId     String?        @map("azure_id") @db.VarChar(100)
  azureTitle  String?        @map("azure_title") @db.VarChar(255)
  azureState  String?        @map("azure_state") @db.VarChar(100)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz()
  project     RoadmapProject @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, type, status])
  @@map("roadmap_work_item_create_requests")
}

model RoadmapRole {
  id                      String              @id @default(uuid()) @db.Uuid
  projectId               String?             @map("project_id") @db.Uuid
  azureEstimateField      String?             @map("azure_estimate_field") @db.VarChar(255)
  defaultPersonExternalId String?             @map("default_person_external_id") @db.VarChar(255)
  name                    String              @db.VarChar(100)
  color                   String              @default("#6366f1") @db.VarChar(20)
  isMock                  Boolean             @default(false) @map("is_mock")
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  project                 RoadmapProject?     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  defaultPerson           RoadmapPerson?      @relation("RoadmapRoleDefaultPerson", fields: [defaultPersonExternalId], references: [externalId], onDelete: SetNull)
  allocations             RoadmapAllocation[]
  members                 RoadmapRoleMember[]

  @@unique([projectId, name])
  @@unique([projectId, azureEstimateField])
  @@map("roadmap_roles")
}

model RoadmapAllocation {
  id               String                    @id @default(uuid()) @db.Uuid
  workItemId       String                    @map("work_item_id") @db.Uuid
  roleId           String                    @map("role_id") @db.Uuid
  personExternalId String                    @map("person_external_id") @db.VarChar(255)
  personName       String                    @map("person_name") @db.VarChar(255)
  personEmail      String?                   @map("person_email") @db.VarChar(255)
  quarterKey       String                    @map("quarter_key") @db.VarChar(7)
  estimatedHours   Decimal                   @map("estimated_hours") @db.Decimal(10, 2)
  /// Azure DevOps Task that mirrors this allocation; Roadmap creates and updates it.
  azureTaskId      String?                   @map("azure_task_id") @db.VarChar(100)
  /// null = never sent, pending | sending | synced | error | skipped.
  azureSyncStatus  String?                   @map("azure_sync_status") @db.VarChar(20)
  azureSyncClaimId String?                   @map("azure_sync_claim_id") @db.Uuid
  azureSyncClaimedAt DateTime?                @map("azure_sync_claimed_at") @db.Timestamptz()
  azureSyncRequested Boolean                 @default(false) @map("azure_sync_requested")
  azureCreateAttemptId String?               @map("azure_create_attempt_id") @db.Uuid
  azureCreateOrganization String?            @map("azure_create_organization") @db.VarChar(255)
  azureSyncError   String?                   @map("azure_sync_error") @db.VarChar(1000)
  azureSyncedAt    DateTime?                 @map("azure_synced_at") @db.Timestamptz()
  /// Estimate last written to the Azure DevOps Task, used to detect plan changes.
  azurePushedHours Decimal?                  @map("azure_pushed_hours") @db.Decimal(10, 2)
  workItem         RoadmapWorkItem           @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  role             RoadmapRole               @relation(fields: [roleId], references: [id], onDelete: Restrict)
  periods          RoadmapPeriodAllocation[]
  updatedAt        DateTime                  @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([workItemId, roleId, personExternalId, quarterKey], map: "roadmap_allocations_person_quarter_key")
  @@index([workItemId])
  @@index([azureSyncStatus])
  @@index([azureSyncClaimedAt])
  @@index([azureTaskId])
  @@map("roadmap_allocations")
}

model RoadmapPeriodAllocation {
  id           String            @id @default(uuid()) @db.Uuid
  allocationId String            @map("allocation_id") @db.Uuid
  monthKey     String?           @map("month_key") @db.VarChar(7)
  label        String            @db.VarChar(100)
  startsAt     DateTime          @map("starts_at") @db.Date
  endsAt       DateTime          @map("ends_at") @db.Date
  hours        Decimal           @db.Decimal(10, 2)
  allocation   RoadmapAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)

  @@index([allocationId, startsAt])
  @@unique([allocationId, monthKey])
  @@map("roadmap_period_allocations")
}

model RoadmapPerson {
  id              String              @id @default(uuid()) @db.Uuid
  externalId      String              @unique @map("external_id") @db.VarChar(255)
  name            String              @db.VarChar(255)
  email           String?             @db.VarChar(255)
  isActive        Boolean             @default(true) @map("is_active")
  isMock          Boolean             @default(false) @map("is_mock")
  syncedAt        DateTime            @map("synced_at") @db.Timestamptz()
  roleMemberships RoadmapRoleMember[]
  defaultForRoles RoadmapRole[]       @relation("RoadmapRoleDefaultPerson")

  @@index([isActive, name])
  @@map("roadmap_people")
}

model RoadmapRoleMember {
  id                String        @id @default(uuid()) @db.Uuid
  roleId            String        @map("role_id") @db.Uuid
  personId          String        @map("person_id") @db.Uuid
  allocationPercent Decimal       @default(100) @map("allocation_percent") @db.Decimal(5, 2)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  role              RoadmapRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  person            RoadmapPerson @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([roleId, personId])
  @@index([personId])
  @@map("roadmap_role_members")
}
