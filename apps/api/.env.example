# Локальная разработка — скопируйте в apps/api/.env
# Не коммитьте .env с реальными секретами.

# PostgreSQL (Docker Compose по умолчанию)
DATABASE_URL="postgresql://tracker:tracker@localhost:5432/tracker?schema=public"

# API
PORT=3001
NODE_ENV=development
# Comma-separated frontend origins
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Способ входа: local (по умолчанию: локальный админ и свои JWT) или entra (Microsoft Entra ID / MSAL).
# Фронт узнаёт режим у API через GET /auth/config, отдельная настройка ему не нужна.
AUTH_PROVIDER=local
# Для AUTH_PROVIDER=entra: GUID тенанта, client id SPA-приложения и аудитория API
# (aud в токене, обычно client id API-приложения). Scope по умолчанию: <аудитория>/access_as_user.
# В манифесте API-приложения нужен "requestedAccessTokenVersion": 2, иначе Entra выдаёт v1-токены
# и API их отклонит. Redirect URI SPA-приложения: <адрес фронта>/login.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_API_AUDIENCE=
# ENTRA_API_SCOPE=

# Локальный администратор admin@tracker.local (только для AUTH_PROVIDER=local). Укажите свой пароль (от 7 символов).
LOCAL_ADMIN_PASSWORD=
# Независимый секрет подписи JWT (от 32 символов).
JWT_SECRET=
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# Azure DevOps Roadmap integration (PAT stays server-side; grant read access to Projects, Work Items, and Graph)
AZURE_DEVOPS_ORG_URL=
AZURE_DEVOPS_PAT=

# Encryption key for credentials saved from the Roadmap admin UI
ROADMAP_ENCRYPTION_KEY=

# AI assistant in the plan table (@mtkit/agent-integration, OpenAI-compatible chat completions)
HRNNG_API_URL=
HRNNG_API_KEY=
HRNNG_MODEL=
# native | json (json for models without native tool calling)
AGENT_TOOL_MODE=native
AGENT_MAX_STEPS=12
