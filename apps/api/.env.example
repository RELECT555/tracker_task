# Локальная разработка — скопируйте в apps/api/.env
# Не коммитьте .env с реальными секретами.

# PostgreSQL (Docker Compose по умолчанию)
DATABASE_URL="postgresql://tracker:tracker@localhost:5432/tracker?schema=public"

# API
PORT=3001
NODE_ENV=development

# Ops kill-switch for SLA auto-escalation cron (admin UI has a separate DB flag).
# Set to false to disable the checker entirely without redeploying UI settings.
SLA_CHECK_ENABLED=true

# Dev-auth: ID пользователя из seed (см. prisma/seed.ts)
# Игнорируется при AUTH_MODE=strict
DEV_USER_ID=00000000-0000-4000-8000-000000000002

# dev — JWT или DEV_USER_ID / X-User-Id; strict — только JWT
AUTH_MODE=dev
JWT_SECRET="dev-only-change-me"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# Опционально — профиль full в docker compose
REDIS_URL="redis://localhost:6379"
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="tracker-attachments"
